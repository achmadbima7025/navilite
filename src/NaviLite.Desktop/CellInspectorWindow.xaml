<Window x:Class="NaviLite.Desktop.CellInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cell value · read only" Width="980" Height="690" MinWidth="650" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#F5F7FC" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="18">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="ValueTitle" FontWeight="SemiBold" FontSize="17" TextWrapping="Wrap" />
            <TextBlock x:Name="ValueSummary" Foreground="#65758C" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <Border Grid.Row="1" Background="#EDF1F9" CornerRadius="6" Padding="10" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="ValueSource" Foreground="#52627B" TextWrapping="Wrap" />
                <TextBlock x:Name="ValueWarning" Foreground="#986817" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,0" />
            </StackPanel>
        </Border>
        <TabControl x:Name="ValueTabs" Grid.Row="2" SelectionChanged="ValueTabs_SelectionChanged" Background="White" BorderBrush="#DFE5F0">
            <TabItem x:Name="TextTab" Header="Text">
                <TextBox x:Name="TextValue" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                         TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BorderThickness="0" Margin="8" />
            </TabItem>
            <TabItem x:Name="JsonTab" Header="JSON formatter">
                <DockPanel Margin="8">
                    <TextBlock x:Name="JsonMessage" DockPanel.Dock="Top" Foreground="#986817" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBox x:Name="JsonValue" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" BorderThickness="0" />
                </DockPanel>
            </TabItem>
            <TabItem x:Name="HexTab" Header="Hex / bytes">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" Text="Offset      Hexadecimal bytes                                  ASCII" FontFamily="Cascadia Mono, Consolas" Foreground="#65758C" Margin="0,0,0,8" />
                    <ListBox x:Name="HexLines" FontFamily="Cascadia Mono, Consolas" FontSize="12" BorderThickness="0" DisplayMemberPath="Display"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Virtualized hexadecimal cell bytes" />
                </DockPanel>
            </TabItem>
        </TabControl>
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="ActionStatus" Foreground="#65758C" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CopyButton" Content="Copy value" Click="Copy_Click" Padding="12,7" Margin="0,0,8,0" />
                <Button x:Name="SaveButton" Content="Save loaded bytes…" Click="Save_Click" Padding="12,7" Margin="0,0,8,0" />
                <Button Content="Close" IsCancel="True" Padding="12,7" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
