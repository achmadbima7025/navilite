<UserControl x:Class="NaviLite.Desktop.ColumnQueryHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="110" HorizontalAlignment="Stretch" Unloaded="Header_Unloaded">
    <UserControl.Resources>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Padding" Value="4,3" /><Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#52627B" /><Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="SortButton" TargetType="Button" BasedOn="{StaticResource HeaderButton}">
            <Style.Triggers><DataTrigger Binding="{Binding HasSort}" Value="True"><Setter Property="Foreground" Value="#177D70" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="FilterToggle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="5,4" /><Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#8A98AA" /><Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasFilters}" Value="True"><Setter Property="Foreground" Value="#177D70" /><Setter Property="Background" Value="#E8F4F0" /></DataTrigger>
                <DataTrigger Binding="{Binding IsFilterPending}" Value="True"><Setter Property="Foreground" Value="#9B6A13" /><Setter Property="Background" Value="#FFF3D9" /></DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="6,4">
        <Grid.RowDefinitions><RowDefinition Height="28" /><RowDefinition Height="28" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding SqlType}" VerticalAlignment="Center" Margin="4,0,0,0" />
                <Button Grid.Column="1" Style="{StaticResource SortButton}" Click="Sort_Click" FontSize="11" Content="{Binding SortLabel}" IsEnabled="{Binding CanEdit}"
                        ToolTip="Sort ascending → descending → default. Shift-click to add to the current sort order." />
            </Grid>
            <ToggleButton x:Name="FilterButton" Grid.Column="1" Style="{StaticResource FilterToggle}" ToolTip="Filter options for this column" IsEnabled="{Binding CanEdit}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M 0,0 L 10,0 L 6,4 L 6,9 L 4,10 L 4,4 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Width="10" Height="10" />
                    <TextBlock Text="{Binding FilterCount}" FontSize="10" Margin="2,0,0,0" />
                </StackPanel>
            </ToggleButton>
        </Grid>
        <Border Grid.Row="1" Background="White" BorderBrush="#DCE3EC" BorderThickness="1" CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="25" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Button Content="{Binding OperatorLabel}" Style="{StaticResource HeaderButton}" Click="Operator_Click" ToolTip="{Binding OperatorName}" FontSize="11" IsEnabled="{Binding CanEdit}" />
                <TextBox x:Name="QuickFilter" Grid.Column="1" Text="{Binding QuickValue, UpdateSourceTrigger=PropertyChanged}"
                         IsReadOnly="{Binding QuickReadOnly}" IsEnabled="{Binding QuickInputEnabled}" KeyDown="QuickFilter_KeyDown" BorderThickness="0" Background="Transparent" Padding="3,2"
                         FontSize="11" MaxLength="4096" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding Name, StringFormat=Filter {0}}"
                         ToolTip="Enter a literal value, then press Enter or Apply. Clear the input to remove this quick condition. Use filter options for operators or multiple conditions." />
                <TextBlock Grid.Column="1" Text="{Binding QuickHint}" Foreground="#9AA7B7" FontSize="11" Margin="3,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=QuickFilter}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
        <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=FilterButton}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               IsOpen="{Binding IsChecked, ElementName=FilterButton, Mode=TwoWay}"
               DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <Border Background="White" BorderBrush="#CFD9E6" BorderThickness="1" CornerRadius="6" Padding="14" Width="350" Margin="0,3,3,5">
                <StackPanel IsEnabled="{Binding CanEdit}">
                    <TextBlock Text="{Binding Name, StringFormat=Filter · {0}}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SqlType}" Foreground="#8090A7" FontSize="10" Margin="0,3,0,12" />
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Filters}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="125" /><ColumnDefinition /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding Operators}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectedValue="{Binding Operator}" Padding="4" FontSize="11" />
                                    <TextBox Grid.Column="1" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ValueEnabled}" Padding="5,4" Margin="5,0" MaxLength="4096" FontSize="11" />
                                    <Button Grid.Column="2" Content="×" Click="RemoveCondition_Click" Padding="4" Margin="0" ToolTip="Remove condition" />
                                </Grid>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="Use Equals with a blank value to match an empty string. Conditions use the table's AND / OR option." TextWrapping="Wrap" Foreground="#8090A7" FontSize="10" Margin="0,0,0,12" />
                    <DockPanel>
                        <Button Content="+ Condition" Click="AddCondition_Click" IsEnabled="{Binding CanAddFilter}" Padding="8,5" Margin="0,0,6,0" />
                        <Button Content="Clear" Click="ClearConditions_Click" Padding="8,5" Margin="0,0,6,0" />
                        <Button Content="Apply" Command="{Binding Owner.ApplyQueryCommand}" Click="Apply_Click" Padding="12,5" Margin="0" Background="#177D70" Foreground="White" HorizontalAlignment="Right" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
