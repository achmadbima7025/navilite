<Window x:Class="NaviLite.Desktop.ConnectionImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import connections" Width="1050" Height="620" MinWidth="820" MinHeight="440"
        WindowStartupLocation="CenterOwner" Background="#F4F6FA" FontFamily="Segoe UI" FontSize="13">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="Choose connections to import" FontSize="23" FontWeight="SemiBold" />
            <TextBlock Text="Import adds connection profiles. Enter passwords after import; existing credentials stay in Windows Credential Manager."
                       TextWrapping="Wrap" Foreground="#65758C" Margin="0,8,0,0" />
            <TextBlock Text="Duplicates are skipped. CA certificate paths may need updating on this computer."
                       TextWrapping="Wrap" Foreground="#65758C" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Select new" Click="SelectNew_Click" Padding="12,6" Margin="0,0,8,0" />
            <Button Content="Select none" Click="SelectNone_Click" Padding="12,6" />
        </StackPanel>
        <DataGrid Grid.Row="2" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  SelectionUnit="FullRow" HeadersVisibility="Column" BorderBrush="#D7DFEB" Background="White">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Import" Width="55">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSelect}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Select connection to import" /></DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Name after import" Binding="{Binding Candidate.PlannedName}" Width="175" />
                <DataGridTextColumn Header="Endpoint" Binding="{Binding Candidate.Connection.Endpoint}" Width="*" MinWidth="180" />
                <DataGridTextColumn Header="Environment" Binding="{Binding Candidate.Connection.Environment}" Width="100" />
                <DataGridTextColumn Header="Security" Binding="{Binding Candidate.Connection.Security}" Width="140" />
                <DataGridTemplateColumn Header="Status" Width="175">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" ToolTip="{Binding Details}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="4,0" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionSummary" Foreground="#65758C" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ImportButton" Content="Import selected" Click="Import_Click" IsDefault="True" Padding="14,8" Margin="0,0,8,0" />
                <Button Content="Cancel" IsCancel="True" Padding="14,8" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
