<Window x:Class="NaviLite.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:NaviLite.Desktop.Models"
        Title="{Binding WindowTitle}" Width="1240" Height="820" MinWidth="1040" MinHeight="740"
        WindowStartupLocation="CenterScreen" Background="#F4F6FA" Foreground="#17243B"
        FontFamily="Segoe UI" FontSize="13" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.InputBindings><KeyBinding Key="G" Modifiers="Control" Command="{Binding ToggleFormCommand}" /></Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <HierarchicalDataTemplate DataType="{x:Type models:SchemaNode}" ItemsSource="{Binding Children}">
            <Grid ToolTip="{Binding Detail}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Icon}" Foreground="#177D70" VerticalAlignment="Top" Margin="0,3,0,0" />
                <StackPanel Grid.Column="1" Margin="0,2,0,4">
                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Foreground="#8090A7" FontSize="10" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Detail}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </HierarchicalDataTemplate>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D7DFEB" />
            <Setter Property="Foreground" Value="#17243B" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="#CED7E5" />
            <Setter Property="Background" Value="White" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBlock" x:Key="FieldLabel">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#52627B" />
        </Style>
        <Style TargetType="Border" x:Key="Card">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E0E6F0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E0E6F0" BorderThickness="0,0,0,1" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#177D70" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                        <TextBlock Text="N" Foreground="White" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="NaviLite" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Text="MYSQL / MARIADB" Foreground="#8090A7" FontSize="11" Margin="18,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Import connections…" Click="ImportConnections_Click" IsEnabled="{Binding CanEdit}" ToolTip="Preview and add connection metadata from a NaviLite file" />
                    <Button Content="Export connections…" Click="ExportConnections_Click" IsEnabled="{Binding CanExportConnections}" ToolTip="Export all saved profiles as metadata without passwords" />
                    <Button Content="New connection" Command="{Binding NewCommand}" />
                    <TextBlock Text="{Binding AppVersion, StringFormat=v{0}}" Foreground="#7D8BA1" Margin="12,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E0E6F0" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="3" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BoolVisibility}}" Foreground="#177D70" />
                <TextBlock Grid.Row="1" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,5,0,0" />
            </Grid>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="#E0E6F0" BorderThickness="0,0,1,0" Padding="18,24">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="150" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="CONNECTIONS" Foreground="#8090A7" FontWeight="SemiBold" FontSize="11" Margin="4,0,0,14" />
                    <ListBox Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" IsEnabled="{Binding CanEdit}"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,10" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="14" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <Ellipse Fill="{Binding EnvironmentColor}" Width="7" Height="7" VerticalAlignment="Top" Margin="0,5,0,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Endpoint}" Foreground="#8090A7" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="2" Margin="4,18,0,10">
                        <TextBlock Text="DATABASE EXPLORER" Foreground="#8090A7" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center" />
                        <Button Content="↻" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" Margin="0" Padding="8,3" ToolTip="Refresh databases" />
                    </Grid>
                    <StackPanel Grid.Row="3" Margin="0,0,0,10">
                        <TextBlock Text="Filter loaded objects" Foreground="#8090A7" FontSize="10" Margin="2,0,0,5" />
                        <TextBox Text="{Binding ObjectFilter, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanBrowse}" ToolTip="Filter loaded object names; unopened branches stay available" AutomationProperties.Name="Filter loaded objects" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Definition" Command="{Binding InspectDefinitionCommand}" Padding="9,5" ToolTip="Inspect the selected database or object without reading its data" />
                            <Button Content="Reload branch" Command="{Binding RefreshBranchCommand}" Padding="9,5" Margin="0" ToolTip="Select an object category to reload only that branch" />
                        </WrapPanel>
                    </StackPanel>
                    <TreeView x:Name="SchemaTree" Grid.Row="4" ItemsSource="{Binding Databases}" BorderThickness="0" Background="Transparent"
                              IsEnabled="{Binding CanBrowse}" TreeViewItem.Expanded="Schema_Expanded" SelectedItemChanged="Schema_SelectedItemChanged"
                              MouseDoubleClick="Schema_MouseDoubleClick" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolVisibility}}" />
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>
                </Grid>
            </Border>
            <TabControl Grid.Column="1" Margin="16,18,16,12" Background="Transparent" BorderThickness="0" SelectedIndex="{Binding SelectedWorkspaceTab}">
              <TabItem Header="Connection">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="28,24">
                    <TextBlock Text="Connection workspace" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock Text="A direct connection to your data." Foreground="#75849A" Margin="0,7,0,22" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="285" /></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="22">
                            <StackPanel>
                                <TextBlock Text="Connection details" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,20" />
                                <StackPanel IsEnabled="{Binding CanEdit}">
                                    <TextBlock Text="Connection name" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Draft.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="85" /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock Text="Host" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding Draft.Host, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock Text="Port" Style="{StaticResource FieldLabel}" /><TextBox Text="{Binding PortText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel>
                                    </Grid>
                                    <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Draft.Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />
                                    <TextBlock Text="Password" Style="{StaticResource FieldLabel}" />
                                    <PasswordBox x:Name="ConnectionPassword" Padding="10,8" BorderBrush="#CED7E5" PasswordChanged="Password_Changed" />
                                    <CheckBox Content="Remember password securely" IsChecked="{Binding Draft.RememberPassword}" Margin="0,10,0,16" />
                                    <TextBlock Text="Environment" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding Environments}" SelectedItem="{Binding Draft.Environment}" Padding="8,6" Margin="0,0,0,18" />
                                    <Separator Background="#E0E6F0" Margin="0,0,0,14" />
                                    <CheckBox Content="Require TLS · verify server certificate" IsChecked="{Binding Draft.UseTls}" Margin="0,0,0,12" />
                                    <TextBlock Text="CA certificate (optional)" Style="{StaticResource FieldLabel}" />
                                    <DockPanel IsEnabled="{Binding Draft.UseTls}">
                                        <Button DockPanel.Dock="Right" Content="…" Click="BrowseCertificate_Click" Margin="8,0,0,0" Padding="10,4" ToolTip="Choose a CA certificate" />
                                        <TextBox Text="{Binding Draft.CaCertificate, UpdateSourceTrigger=PropertyChanged}" ToolTip="Use system trust roots or choose a PEM / DER certificate" />
                                    </DockPanel>
                                </StackPanel>
                                <WrapPanel Margin="0,22,0,0">
                                    <Button Content="Save profile" Command="{Binding SaveCommand}" />
                                    <Button Content="Delete" Command="{Binding DeleteCommand}" Foreground="#B24F51" Margin="0" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Column="2">
                            <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="Session" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ActiveConnection}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,16,0,8" />
                                    <TextBlock Text="{Binding ServerSummary}" TextWrapping="Wrap" Foreground="#75849A" Margin="0,0,0,20" />
                                    <Button Content="Test connection" Command="{Binding TestCommand}" Margin="0,0,0,10" />
                                    <Button Content="Connect" Command="{Binding ConnectCommand}" Background="#177D70" Foreground="White" BorderBrush="#177D70" Margin="0,0,0,10" />
                                    <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Margin="0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="20">
                                <StackPanel>
                                    <TextBlock Text="Activity" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <ListBox ItemsSource="{Binding Activity}" Height="205" BorderThickness="0" Background="Transparent"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Foreground="#75849A" FontSize="11">
                                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8" /></DataTemplate></ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="Passwords are stored in Windows Credential Manager, separately from connection profiles."
                               Foreground="#8090A7" FontSize="11" Margin="2,18,0,0" TextWrapping="Wrap" />
                </StackPanel>
              </ScrollViewer>
              </TabItem>
              <TabItem Header="Data explorer">
                <Grid Margin="14,16">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ObjectTitle}" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ServerSummary}" Foreground="#75849A" Margin="0,6,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Disconnect" Command="{Binding DisconnectCommand}" VerticalAlignment="Top" Margin="10,0,0,0" />
                    </Grid>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,14">
                        <Button Content="Open selected" Command="{Binding OpenTableCommand}" />
                        <Button Content="Refresh data" Command="{Binding ReloadPageCommand}" />
                        <Button Content="← Previous" Command="{Binding PreviousPageCommand}" />
                        <Button Content="Next →" Command="{Binding NextPageCommand}" Margin="0" />
                        <Menu Background="Transparent" IsEnabled="{Binding CanQuery}" Margin="10,0,0,0" VerticalAlignment="Center">
                            <MenuItem Header="Copy rows as…" Padding="10,8">
                                <MenuItem Header="CSV (with headers)" Tag="Csv" Click="CopyRows_Click" />
                                <MenuItem Header="TSV (with headers)" Tag="Tsv" Click="CopyRows_Click" />
                                <MenuItem Header="JSON array" Tag="Json" Click="CopyRows_Click" />
                                <Separator />
                                <MenuItem Header="SQL INSERT (selected rows)" Tag="SqlInsert" Click="CopyRows_Click" ToolTip="Base tables only. Copies complete values; generated columns are omitted." />
                                <MenuItem Header="SQL UPDATE (by primary key)" Tag="SqlUpdate" Click="CopyRows_Click" ToolTip="Uses original primary keys. Key and generated columns are omitted from SET." />
                            </MenuItem>
                        </Menu>
                    </WrapPanel>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <WrapPanel IsEnabled="{Binding CanQuery}">
                                <ComboBox ItemsSource="{Binding MatchModes}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectedValue="{Binding MatchMode}" Width="205" Padding="6" Margin="0,0,10,8" ToolTip="Combine the selected filter conditions with AND or OR. Rows with column None are ignored." />
                                <Button Content="+ Filter" Command="{Binding AddFilterCommand}" Padding="10,6" Margin="0,0,8,8" />
                                <Button Content="+ Sort" Command="{Binding AddSortCommand}" Padding="10,6" Margin="0,0,8,8" />
                                <Button Content="Apply" Command="{Binding ApplyQueryCommand}" Padding="10,6" Margin="0,0,8,8" />
                                <Button Content="Reset" Command="{Binding ResetQueryCommand}" Padding="10,6" Margin="0,0,0,8" />
                            </WrapPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="210" IsEnabled="{Binding CanQuery}" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="10" /><ColumnDefinition Width="125" /><ColumnDefinition Width="10" /><ColumnDefinition /><ColumnDefinition Width="35" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="Filter column" Foreground="#75849A" FontSize="11" />
                                        <TextBlock Grid.Column="2" Text="Condition" Foreground="#75849A" FontSize="11" />
                                        <TextBlock Grid.Column="4" Text="Literal value" Foreground="#75849A" FontSize="11" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding DraftFilters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="10" /><ColumnDefinition Width="125" /><ColumnDefinition Width="10" /><ColumnDefinition /><ColumnDefinition Width="35" /></Grid.ColumnDefinitions>
                                                    <ComboBox ItemsSource="{Binding Columns}" DisplayMemberPath="Label" SelectedValuePath="Name" SelectedValue="{Binding Column}" Padding="6" AutomationProperties.Name="Filter column" />
                                                    <ComboBox Grid.Column="2" ItemsSource="{Binding Operators}" DisplayMemberPath="Label" SelectedValuePath="Code" SelectedValue="{Binding Operator}" Padding="6" AutomationProperties.Name="Filter condition" />
                                                    <TextBox Grid.Column="4" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ValueEnabled}" MaxLength="4096" Padding="8,6" ToolTip="A literal value. Percent and underscore are text in Contains / Starts with." />
                                                    <Button Grid.Column="5" Content="×" Click="RemoveQueryRow_Click" Padding="7,4" Margin="5,0,0,0" ToolTip="Remove filter" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Order by · highest priority first" Foreground="#75849A" FontSize="11" Margin="0,6,0,5" />
                                    <ItemsControl ItemsSource="{Binding DraftSorts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="180" /><ColumnDefinition Width="10" /><ColumnDefinition Width="85" /><ColumnDefinition /><ColumnDefinition Width="32" /><ColumnDefinition Width="32" /><ColumnDefinition Width="35" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Priority}" Foreground="#75849A" VerticalAlignment="Center" />
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Columns}" DisplayMemberPath="Label" SelectedValuePath="Name" SelectedValue="{Binding Column}" Padding="6" AutomationProperties.Name="Sort column" />
                                                    <ComboBox Grid.Column="3" ItemsSource="{Binding Directions}" SelectedItem="{Binding Direction}" Padding="6" AutomationProperties.Name="Sort direction" />
                                                    <Button Grid.Column="5" Content="↑" Tag="-1" Click="MoveSort_Click" IsEnabled="{Binding CanMoveUp}" Padding="6,4" Margin="0,0,3,0" ToolTip="Higher sort priority" />
                                                    <Button Grid.Column="6" Content="↓" Tag="1" Click="MoveSort_Click" IsEnabled="{Binding CanMoveDown}" Padding="6,4" Margin="0,0,3,0" ToolTip="Lower sort priority" />
                                                    <Button Grid.Column="7" Content="×" Click="RemoveQueryRow_Click" Padding="7,4" Margin="5,0,0,0" ToolTip="Remove sort" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                            <TextBlock Text="{Binding QuerySummary}" ToolTip="{Binding QuerySummary}" Foreground="#52627B" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="36" FontSize="11" />
                            <TextBlock Text="{Binding QueryDraftMessage}" Foreground="#AA7620" TextWrapping="Wrap" FontSize="11" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <TabControl Grid.Row="3" Background="White" BorderBrush="#E0E6F0" SelectedIndex="{Binding DataViewIndex}">
                        <TabItem Header="Data · read only">
                            <DockPanel Margin="8">
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding PageSummary}" TextWrapping="Wrap" Foreground="#75849A" FontSize="11" Margin="4,12,4,4" />
                                <DataGrid x:Name="PreviewGrid" ItemsSource="{Binding Page.Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                                          PreviewKeyDown="PreviewGrid_KeyDown" MouseDoubleClick="PreviewGrid_MouseDoubleClick" ToolTip="Double-click a cell or press F2 to inspect its value."
                                          CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="True" CanUserReorderColumns="True" Sorting="PreviewGrid_Sorting"
                                          EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="29"
                                          Background="White" BorderThickness="0" HorizontalGridLinesBrush="#EEF1F7" AlternatingRowBackground="#F8FAFD"
                                          SelectedItem="{Binding SelectedRecord, Mode=TwoWay}" SelectionUnit="FullRow" SelectionMode="Extended" ClipboardCopyMode="IncludeHeader" AutomationProperties.Name="Read-only table data preview" />
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Form · read only" ToolTip="Switch grid / form with Ctrl+G">
                            <DockPanel Margin="10">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding RecordSummary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="← Record" Command="{Binding PreviousRecordCommand}" Padding="10,5" />
                                        <Button Content="Record →" Command="{Binding NextRecordCommand}" Padding="10,5" Margin="0" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock DockPanel.Dock="Bottom" Text="{Binding PageSummary}" TextWrapping="Wrap" Foreground="#75849A" FontSize="11" Margin="4,10,4,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="135" /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <ListBox ItemsSource="{Binding Page.Rows}" SelectedItem="{Binding SelectedRecord, Mode=TwoWay}" DisplayMemberPath="Label"
                                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                                             BorderBrush="#E0E6F0" Background="#F8FAFD" AutomationProperties.Name="Records in the current page" />
                                    <ListBox Grid.Column="2" ItemsSource="{Binding FormFields}" BorderThickness="0" Background="Transparent"
                                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" Focusable="False">
                                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Focusable" Value="False" /></Style></ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E0E6F0" BorderThickness="0,0,0,1" Padding="6,10">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            <TextBlock Text="{Binding SqlType}" Foreground="#8090A7" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                            <TextBlock Text="NULL" Foreground="#8090A7" FontStyle="Italic" Visibility="{Binding IsNull, Converter={StaticResource BoolVisibility}}" FontSize="10" Margin="0,4,0,0" />
                                                            <TextBlock Text="Binary preview" Foreground="#8090A7" Visibility="{Binding IsBinary, Converter={StaticResource BoolVisibility}}" FontSize="10" Margin="0,4,0,0" />
                                                            <Button Content="Inspect…" Click="InspectFormField_Click" Padding="8,4" Margin="0,8,0,0" HorizontalAlignment="Left" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" BorderThickness="0" Background="#F8FAFD" Padding="8" MaxHeight="210" VerticalScrollBarVisibility="Auto" />
                                                            <TextBlock Text="Shortened preview" Foreground="#AA7620" FontSize="10" Visibility="{Binding IsTruncated, Converter={StaticResource BoolVisibility}}" Margin="6,4,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Definition">
                            <TextBox Text="{Binding Ddl, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                                     AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="8" BorderThickness="0" />
                        </TabItem>
                    </TabControl>
                </Grid>
              </TabItem>
              <TabItem Header="SQL history">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="2*" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="Session SQL history" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Refresh" Command="{Binding RefreshHistoryCommand}" />
                            <Button Content="Clear" Command="{Binding ClearHistoryCommand}" Margin="0" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="1" Text="{Binding HistoryStatus}" Foreground="#75849A" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <DataGrid Grid.Row="2" ItemsSource="{Binding SqlHistory}" SelectedItem="{Binding SelectedHistory, Mode=TwoWay}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow" EnableRowVirtualization="True" BorderBrush="#E0E6F0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Started" Binding="{Binding Time}" SortMemberPath="StartedUnixMs" Width="105" />
                            <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" SortMemberPath="DurationMs" Width="90" />
                            <DataGridTextColumn Header="Result" Binding="{Binding Status}" Width="95" />
                            <DataGridTextColumn Header="Operation" Binding="{Binding Operation}" Width="130" />
                            <DataGridTextColumn Header="Context" Binding="{Binding Context}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="#DCE3EF" />
                    <TextBox Grid.Row="4" Text="{Binding HistoryStatement, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                             AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                </Grid>
              </TabItem>
              <TabItem Header="Object definition">
                <Grid Margin="12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="130" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="{Binding DefinitionTitle}" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DefinitionTitle}" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="1" Text="{Binding DefinitionSummary}" Foreground="#75849A" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <WrapPanel Grid.Row="2" Margin="0,0,0,12">
                        <Button Content="Refresh definition" Command="{Binding ReloadDefinitionCommand}" />
                        <Button Content="Copy SQL" Command="{Binding CopyDefinitionCommand}" />
                        <Button Content="Save SQL…" Click="SaveDefinition_Click" IsEnabled="{Binding CanExportDefinition}" Margin="0" />
                    </WrapPanel>
                    <DataGrid Grid.Row="3" ItemsSource="{Binding Definition.Properties}" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single" HeadersVisibility="Column" BorderBrush="#E0E6F0" AutomationProperties.Name="Object definition metadata">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Property" Binding="{Binding Name}" Width="200" />
                            <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <GridSplitter Grid.Row="4" Height="5" HorizontalAlignment="Stretch" Background="#DCE3EF" />
                    <TextBox Grid.Row="5" Text="{Binding DefinitionSql, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="13"
                             AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Read-only object CREATE statement" />
                </Grid>
              </TabItem>
              <TabItem Header="SQL editor">
                <Grid Margin="12" PreviewKeyDown="SqlWorkspace_KeyDown">
                    <Grid.InputBindings>
                        <KeyBinding Key="F9" Command="{Binding RunSqlCommand}" />
                        <KeyBinding Key="F9" Modifiers="Alt" Command="{Binding SelectCurrentSqlCommand}" />
                        <KeyBinding Key="F9" Modifiers="Control" Command="{Binding AnalyzeSqlCommand}" />
                    </Grid.InputBindings>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="2*" /><RowDefinition Height="8" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{Binding SqlDocumentTitle}" FontSize="23" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SqlPath}" Margin="0,0,0,8" />
                    <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                        <Button Content="New" Click="NewSql_Click" IsEnabled="{Binding CanUseSqlEditor}" ToolTip="Ctrl+N" />
                        <Button Content="Open…" Click="OpenSql_Click" IsEnabled="{Binding CanUseSqlEditor}" ToolTip="Ctrl+O" />
                        <Button Content="Save as…" Click="SaveSql_Click" IsEnabled="{Binding CanUseSqlEditor}" ToolTip="Ctrl+S — choose a file and confirm replacement" />
                        <Button Content="Analyze script" Command="{Binding AnalyzeSqlCommand}" ToolTip="Ctrl+F9 — find all statement boundaries" />
                        <Button Content="Select current" Command="{Binding SelectCurrentSqlCommand}" ToolTip="Alt+F9 — highlight the statement at the caret" />
                        <Button Content="Run SELECT" Command="{Binding RunSqlCommand}" ToolTip="F9 — run exactly one SELECT from selected text, or the statement at the caret, in a fresh read-only transaction" />
                    </WrapPanel>
                    <WrapPanel Grid.Row="2" IsEnabled="{Binding CanUseSqlEditor}" Margin="0,0,0,8">
                        <CheckBox Content="Backslash escapes in strings" IsChecked="{Binding SqlBackslashEscapes}" Margin="0,0,16,0" />
                        <CheckBox Content="ANSI_QUOTES" IsChecked="{Binding SqlAnsiQuotes}" ToolTip="Treat double quotes as identifier quotes. Match the script's intended SQL mode." />
                        <TextBlock Text="Database" Margin="18,0,6,0" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding Databases}" DisplayMemberPath="Name" IsEditable="True" Text="{Binding SqlDatabase, UpdateSourceTrigger=PropertyChanged}"
                                  Width="170" ToolTip="Optional default database for this run; leave blank for fully qualified queries" />
                        <TextBlock Text="Rows" Margin="12,0,6,0" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding SqlRowLimits}" SelectedItem="{Binding SqlRowLimit}" Width="75" />
                    </WrapPanel>
                    <TextBlock Grid.Row="3" Text="{Binding SqlAnalysisStatus}" Foreground="#75849A" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBox x:Name="ScriptEditor" Grid.Row="4" Text="{Binding SqlText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanUseSqlEditor}"
                             SelectionChanged="ScriptEditor_SelectionChanged" FontFamily="Cascadia Mono, Consolas" FontSize="13" MaxLength="1048576"
                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="SQL script editor" />
                    <GridSplitter Grid.Row="5" Height="5" HorizontalAlignment="Stretch" Background="#DCE3EF" />
                    <TabControl Grid.Row="6" SelectedIndex="{Binding SqlResultPaneIndex}">
                      <TabItem Header="Statements">
                        <DataGrid ItemsSource="{Binding SqlStatements}" SelectedItem="{Binding SelectedSqlStatement, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                              SelectionMode="Single" SelectionUnit="FullRow" EnableRowVirtualization="True" BorderBrush="#E0E6F0" AutomationProperties.Name="SQL statement boundaries">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="45" />
                            <DataGridTextColumn Header="Line" Binding="{Binding StartLine}" Width="65" />
                            <DataGridTextColumn Header="Statement preview" Binding="{Binding Preview}" Width="*" />
                        </DataGrid.Columns>
                        </DataGrid>
                      </TabItem>
                      <TabItem Header="SELECT result · read only">
                        <DockPanel Margin="6">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding SqlRunStatus}" TextWrapping="Wrap" Foreground="#75849A" Margin="0,0,0,8" />
                            <DataGrid x:Name="SqlResultGrid" ItemsSource="{Binding SqlResult.Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" SelectionMode="Extended" SelectionUnit="FullRow"
                                      EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      ScrollViewer.CanContentScroll="True" ClipboardCopyMode="IncludeHeader" GridLinesVisibility="Horizontal" RowHeight="29"
                                      HorizontalGridLinesBrush="#EEF1F7" AlternatingRowBackground="#F8FAFD" AutomationProperties.Name="Read-only SQL query result" />
                        </DockPanel>
                      </TabItem>
                    </TabControl>
                </Grid>
              </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
